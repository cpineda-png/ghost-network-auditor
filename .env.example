SAMPLE_MODE=true
LLM_REPLAY=true
LLM_RECORD=false
# Listings fetched per run (integer 1-300). Demo window is offset 80, limit 20.
RUN_LIMIT=20
RUN_OFFSET=80
# Claims queries end at this month (YYYY-MM). The window is the 13 months before it.
DATA_AS_OF_MONTH=2026-10
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
# Nightshift as seen from the agents container. Compose uses this instead of 127.0.0.1.
NIGHTSHIFT_DOCKER_BASE_URL=http://host.docker.internal:8088/v1
NIGHTSHIFT_TOKEN=
NIGHTSHIFT_MAX_TOKENS=1500
NEMOTRON_PLANNER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NEMOTRON_WORKER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
ZETARIS_JDBC_URL=
ZETARIS_JDBC_JAR=
ZETARIS_JDBC_DRIVER_CLASS=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
POSTGRES_USER=gna
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plan
NPPES_LIVE=false
NPPES_USER_AGENT=
GNA_TABLE_DIRECTORY=PLAN_PG.directory_listing
GNA_TABLE_ROSTER=GNA_FILES.roster
GNA_TABLE_CLAIMS=GNA_FILES.claims
GNA_RECEIPTS_DIR=./receipts
GNA_SAMPLES_DIR=src/main/resources/samples
RECORD_MODE=false
